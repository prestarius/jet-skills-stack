{
  "description": "Command and secret-file guardrails (PreToolUse), plus an opt-out SessionStart hook that loads the working agreement for plugin installs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/command-guardrails.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/file-guardrails.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/working-agreement.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
